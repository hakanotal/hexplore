# Cloudflare Pages headers. Strict CSP: no third-party scripts, and network
# access only to the services the app calls directly.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://server.arcgisonline.com https://tiles.mapterhorn.com https://api.tomtom.com; font-src 'self'; worker-src 'self' blob:; connect-src 'self' https://places.googleapis.com https://tiles.openfreemap.org https://server.arcgisonline.com https://tiles.mapterhorn.com https://api.tomtom.com https://photon.komoot.io https://nominatim.openstreetmap.org https://overpass-api.de https://openrouter.ai https://api.openrouteservice.org; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
